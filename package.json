{
  "name": "code-store-monorepo",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "bench": "pnpm --filter @code-id-labs/store build && vitest bench --run --config benchmark/vitest.config.ts",
    "compare:size": "pnpm --filter @code-id-labs/store build && node benchmark/compare-size.mjs",
    "clean": "pnpm -r clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @code-id-labs/store build && pnpm --filter @code-id-labs/store test && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "miniprogram-api-typings": "^4.0.1",
    "mobx-miniprogram": "^6.0.0",
    "mobx-miniprogram-bindings": "^4.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}