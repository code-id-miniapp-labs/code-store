<view class="flex items-center justify-between px-4 py-3 bg-default border-b border-default">
  <view class="flex items-center gap-2">
    <text class="text-base font-semibold text-highlighted">Code Café</text>
    <c-badge
      wx:if="{{cartCount > 0}}"
      label="{{cartCount}} in bag"
      color="primary"
      variant="soft"
      size="sm"
    />
  </view>

  <c-button
    label="{{themeMode === 'dark' ? 'Light' : 'Dark'}}"
    size="xs"
    variant="outline"
    leading-icon="{{themeMode === 'dark' ? 'i-lucide-sun' : 'i-lucide-moon'}}"
    bind:tap="handleToggleTheme"
  />
</view>
