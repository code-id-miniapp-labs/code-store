<view class="min-h-screen bg-muted p-4 pb-24 flex flex-col gap-4">
  <c-card wx:if="{{cartCount === 0}}" title="Your bag is empty" description="Add some drinks or pastries from the catalog first.">
    <view slot="footer" class="flex justify-end">
      <c-button label="Back to Menu" color="primary" bind:tap="handleBackToShop" />
    </view>
  </c-card>

  <block wx:else>
    <c-card title="Bag Items" description="Edits sync back to Page 1 automatically on onShow">
      <view class="flex flex-col gap-3 py-1">
        <view
          wx:for="{{cartItems}}"
          wx:key="id"
          class="flex items-center justify-between gap-2"
        >
          <view class="flex flex-col">
            <text class="text-sm font-medium text-highlighted">{{item.name}}</text>
            <text class="text-xs text-muted">{{item.priceLabel}} each</text>
          </view>

          <view class="flex items-center gap-2">
            <c-button
              label="-"
              size="xs"
              variant="outline"
              data-id="{{item.id}}"
              bind:tap="handleDecrement"
            />
            <text class="min-w-6 text-center text-sm font-semibold text-default">{{item.qty}}</text>
            <c-button
              label="+"
              size="xs"
              color="primary"
              data-id="{{item.id}}"
              bind:tap="handleIncrement"
            />
          </view>
        </view>
      </view>
    </c-card>

    <c-card title="Order Note" description="Debounced persistent store (300ms + auto wx.onAppHide flush)">
      <c-input
        value="{{orderNote}}"
        placeholder="e.g. Less ice, oat milk..."
        bind:input="handleNoteInput"
      />
    </c-card>

    <order-summary />
  </block>

  <view
    wx:if="{{cartCount > 0}}"
    class="fixed bottom-0 left-0 right-0 px-4 py-3 bg-default border-t border-default flex items-center justify-between gap-3"
  >
    <c-button
      label="Clear"
      variant="ghost"
      color="error"
      bind:tap="handleClearCart"
    />
    <c-button
      label="Place Order · {{formattedTotal}}"
      color="primary"
      bind:tap="handlePlaceOrder"
    />
  </view>
</view>
